<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      spacing="12"
      style="-fx-background-color: #27ae60; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);"
      maxWidth="420" minWidth="350">

    <!-- Cabeçalho -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <ImageView fx:id="iconImage" fitHeight="32" fitWidth="32" />
        <Label fx:id="tituloLabel"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"
               text="Sucesso"
               wrapText="true"
               maxWidth="300"/>
        <!-- ✅ SEM onAction -->
        <Button fx:id="btnFechar"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                text="✕" />
    </HBox>

    <Label fx:id="descricaoLabel"
           style="-fx-font-size: 14px; -fx-text-fill: white; -fx-opacity: 0.95;"
           text="Operação realizada com sucesso!"
           wrapText="true"
           maxWidth="380"/>

    <TextArea fx:id="detalhesArea"
              style="-fx-font-size: 11px; -fx-background-color: rgba(0,0,0,0.15); -fx-text-fill: white; -fx-border-radius: 6; -fx-background-radius: 6;"
              editable="false"
              wrapText="true"
              visible="false"
              managed="false"
              maxHeight="80"
              prefRowCount="3"/>

    <Label fx:id="origemLabel"
           style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.6); -fx-font-style: italic;"
           visible="false"
           managed="false"/>

</VBox>